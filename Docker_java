FROM <acr-login-server>/base/java-build:21-jdk-alpine-3.23 AS build

WORKDIR /workspace

COPY . .

RUN chmod +x gradlew

RUN ./gradlew clean bootJar --no-daemon

FROM <acr-login-server>/base/java-runtime:21-jre-alpine-3.23

WORKDIR /app

COPY --from=build /workspace/build/libs/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java","-XX:+UseContainerSupport","-jar","app.jar"]
